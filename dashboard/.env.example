# Sao chép file này thành .env rồi điền giá trị thật.
# .env KHÔNG được commit (đã có trong .gitignore) -> không lộ mật khẩu lên Git.

# Địa chỉ Ditto (proxy trong vite.config.js sẽ trỏ tới đây)
DITTO_URL=http://localhost:8080

# Basic Auth của Ditto (mặc định demo là ditto/ditto)
DITTO_USER=ditto
DITTO_PASSWORD=ditto

# Namespace chứa mọi Thing của dự án (khớp bridge/ditto_common.py: org.dt4n)
VITE_DITTO_NAMESPACE=org.dt4n
