{
  "agent": {
    "batch_size": 64,
    "buffer_capacity": 20000,
    "device": "cpu",
    "epsilon_decay": 0.995,
    "epsilon_end": 0.05,
    "epsilon_start": 1.0,
    "exploration": "epsilon_greedy",
    "gamma": 0.95,
    "hidden_layers": [
      64,
      32
    ],
    "learning_rate": 0.001,
    "target_update_freq": 200,
    "temp_decay": 0.9985,
    "temp_end": 0.1,
    "temp_start": 2.0,
    "use_double": true,
    "use_dueling": true
  },
  "env": {
    "load_cfg": "SCENARIOS_TRAIN",
    "max_steps": 15
  },
  "seeds": {
    "heldout_seed_start": 2000,
    "heldout_seeds": 50,
    "train_seed_start": 1000,
    "train_seed_stride": 100000,
    "val_seed_start": 500,
    "val_seeds": 20
  },
  "train": {
    "episodes": 2000,
    "eval_every": 25,
    "mask_aoi": false,
    "warmup_steps": 500,
    "z_steps_choices": [
      0,
      1,
      3,
      5,
      8,
      12
    ]
  },
  "version": "train_r_scenario"
}
